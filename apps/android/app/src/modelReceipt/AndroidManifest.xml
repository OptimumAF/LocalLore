<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <activity android:name=".MainActivity" android:exported="false" tools:replace="android:exported">
            <intent-filter tools:node="removeAll" />
        </activity>
        <activity android:name=".LocalModelSetupActivity" android:exported="true" android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".LiteRtPlayActivity" android:exported="false" android:launchMode="singleTask" />
        <service android:name="org.locallore.app.ReceiptProofService" android:exported="false"
            android:process=":receiptproof" android:isolatedProcess="false" />
        <activity android:name=".ReceiptSetupAcceptActivity" android:exported="false" />
        <activity android:name=".ReceiptSetupCancelBeforeActivity" android:exported="false" />
        <activity android:name=".ReceiptSetupCancelAfterActivity" android:exported="false" />
        <activity android:name=".ReceiptSetupDrainActivity" android:exported="false" />
    </application>
</manifest>
