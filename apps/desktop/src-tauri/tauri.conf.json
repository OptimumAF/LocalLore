{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalLore Desktop",
  "version": "0.1.0",
  "identifier": "org.locallore.desktop.spike",
  "build": { "frontendDist": "../dist" },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "capabilities": [{ "identifier": "main-host", "windows": ["main-*"], "permissions": ["allow-host-call", "allow-model-status", "allow-model-import", "allow-model-load", "allow-model-unload", "allow-model-cancel", "allow-inspection-preview", "allow-inspection-database-preview", "allow-inspection-save", "allow-inspection-cancel", "allow-inspection-open", "allow-inspection-storage", "allow-inspection-load", "allow-harness-export-case", "allow-harness-model-case", "allow-harness-checkpoint", "allow-harness-viewport", "allow-harness-finish", "allow-harness-stats", "allow-harness-oracle", "allow-harness-reopen"] }]
    }
  },
  "bundle": { "active": false }
}
