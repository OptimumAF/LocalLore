{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "LocalLore Desktop",
    "version": "0.1.0",
    "identifier": "org.locallore.desktop.spike",
    "build": {
        "frontendDist": "../dist"
    },
    "app": {
        "withGlobalTauri": true,
        "windows": [],
        "security": {
            "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
            "capabilities": [
                {
                    "identifier": "main-host",
                    "windows": ["main-*"],
                    "permissions": [
                        "allow-host-call",
                        "allow-author-context",
                        "allow-author-prepare-start",
                        "allow-author-commit-start",
                        "allow-author-lookup-start",
                        "allow-author-preview-discard",
                        "allow-harness-author-case",
                        "allow-capture-preview",
                        "allow-capture-save",
                        "allow-capture-revoke",
                        "allow-harness-capture-case",
                        "allow-archive-catalog",
                        "allow-fork-start",
                        "allow-fork-lookup",
                        "allow-memory-maintenance-start",
                        "allow-harness-memory-case",
                        "allow-harness-fork-case",
                        "allow-archive-export-preview",
                        "allow-archive-import-preview",
                        "allow-archive-export",
                        "allow-archive-import",
                        "allow-archive-status",
                        "allow-archive-cancel",
                        "allow-archive-discard",
                        "allow-harness-archive-case",
                        "allow-harness-archive-v3-fixture",
                        "allow-model-status",
                        "allow-model-import",
                        "allow-model-load",
                        "allow-model-unload",
                        "allow-model-cancel",
                        "allow-inspection-preview",
                        "allow-inspection-database-preview",
                        "allow-inspection-save",
                        "allow-inspection-cancel",
                        "allow-inspection-open",
                        "allow-inspection-storage",
                        "allow-inspection-load",
                        "allow-harness-export-case",
                        "allow-harness-model-case",
                        "allow-harness-checkpoint",
                        "allow-harness-viewport",
                        "allow-harness-finish",
                        "allow-harness-stats",
                        "allow-harness-oracle",
                        "allow-harness-reopen",
                        "allow-evaluation-catalog",
                        "allow-application-close",
                        "core:event:allow-listen",
                        "core:event:allow-unlisten",
                        "allow-evaluation-curated",
                        "allow-evaluation-comparison",
                        "allow-evaluation-comparison-run",
                        "allow-evaluation-comparison-native",
                        "allow-evaluation-selected",
                        "allow-harness-selected-case",
                        "allow-harness-native-comparison-case",
                        "allow-harness-comparison-reader-case",
                        "allow-evaluation-start",
                        "allow-evaluation-open",
                        "allow-evaluation-status",
                        "allow-evaluation-read",
                        "allow-evaluation-cancel",
                        "allow-evaluation-resume",
                        "allow-evaluation-rerun",
                        "allow-harness-evaluation-case"
                    ]
                }
            ]
        }
    },
    "bundle": {
        "active": false
    }
}
